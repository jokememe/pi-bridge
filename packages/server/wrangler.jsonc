{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pi-bridge",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-17",
	// OAuth 连接器拉取客户端元数据文档（CIMD）时只访问公网地址，防止 SSRF
	"compatibility_flags": ["global_fetch_strictly_public"],
	"keep_vars": true,
	"send_email": [{ "name": "EMAIL" }],
	"observability": {
		"enabled": true,
		"logs": {
			// 请求日志会记录完整 URL，而 MCP 地址的路径里就是用户密钥
			"invocation_logs": false
		}
	},
	"durable_objects": {
		"bindings": [
			{ "name": "REGISTRY", "class_name": "Registry" },
			{ "name": "USER_HUB", "class_name": "UserHub" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["Registry", "UserHub"] }
	],
	// OAuth 的客户端、授权和令牌。不写 id，部署时由 Cloudflare 自动创建
	"kv_namespaces": [{ "binding": "OAUTH_KV" , "id": "01d5eb12265b45d6a895e552f2e47ffd"}],
	"r2_buckets": [{"binding": "TRANSFER_FILES"}]
}
